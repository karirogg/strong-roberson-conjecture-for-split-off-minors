author = {Gregory Gauthier and Tien-Nam Le and Paul Wollan},
abstract = {Building on recent work of Dvořák and Yepremyan, we show that every simple graph of minimum degree 7t+7 contains Kt as an immersion and that every graph with chromatic number at least 3.54t+4 contains Kt as an immersion. We also show that every graph on n vertices with no independent set of size three contains K2⌊n∕5⌋ as an immersion.}
}